# CycleQuant is safe by default. Keep this false until every paper-only check passes.
CQ_TRADING_ENABLED=false
CQ_BROKER_MODE=simulated
CQ_DATABASE_BACKEND=sqlite
CQ_DATABASE_PATH=data/cyclequant.db
CQ_KILL_SWITCH_PATH=data/KILL_SWITCH
CQ_LOG_LEVEL=INFO
CQ_LOG_JSON=true
CQ_DATA_MAX_AGE_HOURS=36
CQ_CONFIRMATION_DAYS=2
CQ_HYSTERESIS_POINTS=5
CQ_MAX_ALLOCATION_STEP=25
CQ_INITIAL_EXPOSURE=0

# Alpaca paper trading only. The application rejects every other base URL.
CQ_ALPACA_BASE_URL=https://paper-api.alpaca.markets
CQ_ALPACA_DATA_URL=https://data.alpaca.markets
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# Optional data sources. Missing optional sources lower confidence; they do not
# silently produce a zero score.
CQ_FRED_CSV_BASE_URL=https://fred.stlouisfed.org/graph/fredgraph.csv
CQ_ETF_FLOWS_URL=

# Optional AI news analysis. The deterministic heuristic is the default and
# requires no account. Gemini's free tier can be selected explicitly; only
# public headlines are sent, and free-tier use may be used by Google to improve
# its products. Never commit a real key.
CQ_NEWS_ANALYZER=heuristic
GEMINI_API_KEY=
CQ_GEMINI_MODEL=gemini-3.8-flash

# Cloud persistence. The writer token belongs only in GitHub Actions or a
# trusted backend—never in a VITE_* variable or browser bundle.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
CYCLEQUANT_WRITE_TOKEN=

# API / dashboard
CQ_API_HOST=127.0.0.1
CQ_API_PORT=8000
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
